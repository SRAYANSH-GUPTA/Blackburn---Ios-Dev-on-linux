# Sourced by scripts/blackburn-macbox.sh. Exported caller values take precedence.
: "${MACBOX_CPUS:=8}" "${MACBOX_MEMORY:=8G}" "${MACBOX_DISK_SIZE:=160G}"
: "${MACBOX_RENDER_NODE:=/dev/dri/renderD128}"
: "${MACBOX_RESOLUTION:=1280x800}" "${MACBOX_REFRESH:=60}"
: "${MACBOX_GPU_TUNING:=auto}" "${MACBOX_BUILD_JOBS:=4}"
# auto only enables ARL_FACTS on upstream's measured Arrow Lake PCI IDs.
# Meteor Lake / Intel Arc uses ANV Vulkan with the portable tuning path.
: "${MACBOX_POOL:=slim-1}" "${MACBOX_SSH_HOST:=macbox}"
export MACBOX_CPUS MACBOX_MEMORY MACBOX_DISK_SIZE MACBOX_RENDER_NODE
export MACBOX_RESOLUTION MACBOX_REFRESH MACBOX_GPU_TUNING MACBOX_POOL MACBOX_SSH_HOST
export MACBOX_BUILD_JOBS
