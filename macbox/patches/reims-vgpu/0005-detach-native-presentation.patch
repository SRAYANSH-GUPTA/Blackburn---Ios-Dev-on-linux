         );
+        if std::env::var("REIMS_VGPU_CLOSE_POLICY").as_deref() == Ok("detach") {
+            self.detach();
+            if let Ok(path) = std::env::var("REIMS_VGPU_VIEW_STATE") {
+                let pending = format!("{path}.closed");
+                if std::fs::write(&pending, "none\n").is_ok() {
+                    let _ = std::fs::rename(pending, path);
+                }
+            }
+            log::info!(target: "reims_vgpu_window", "viewer.closed: detached; guest retained");
+            return;
+        }
         close_asked(self);
+    }
+
+    // Keep the window, Vulkan surface and guest device allocated. Visibility gates
+    // presentation on the render thread; destroying a live surface is unsafe.
+    fn detach(&mut self) {
+        self.detached = true;
+        self.input.close_requested();
+        self.flush();
+        self.capture_changed();
+        self.window.surface().set_visible(false);
+        self.shown = Some(false);
+        // SAFETY: this method runs on SDL's owning UI thread.
+        unsafe {
+            SDL_HideWindow(self.sdl);
+        }
     }

     /// Sends what the input queued to the host's callbacks, while the window has them.
