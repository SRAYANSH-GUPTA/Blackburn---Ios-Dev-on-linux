+
+// A VM-specific file, polled on the UI thread even while the window is hidden.
+// No signal handler touches SDL or destroys renderer resources.
+pub(crate) fn presentation_control() {
+    let Ok(path) = std::env::var("REIMS_VGPU_VIEW_STATE") else {
+        return;
+    };
+    let Ok(value) = std::fs::read_to_string(path) else {
+        return;
+    };
+    let requested = value.trim();
+    OPEN.with(|open| {
+        for shell in open.borrow_mut().iter_mut().filter(|s| !s.closed) {
+            if requested == "none" && !shell.detached {
+                shell.detach();
+            } else if (requested == "native" || requested == "browser-desktop") && shell.detached {
+                // SAFETY: SDL's owning UI thread; surface remains allocated.
+                shell.detached = false;
+                unsafe {
+                    SDL_ShowWindow(shell.sdl);
+                }
+                shell.shown = Some(true);
+                shell.window.surface().set_visible(true);
+            }
+        }
+    });
 }

