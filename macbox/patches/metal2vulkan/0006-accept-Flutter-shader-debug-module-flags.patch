+#[test]
+fn flutter_debug_module_flags_do_not_change_resource_limits() {
+    let abi = module_with(|b| {
+        let dwarf = node(b, &[I(7), S("Dwarf Version"), I(4)]);
+        let debug = node(b, &[I(2), S("Debug Info Version"), I(3)]);
+        let textures = node(b, &[I(7), S("air.max_textures"), I(128)]);
+        b.named_md("llvm.module.flags", &[dwarf, debug, textures]);
+    }).unwrap();
+    assert_eq!(abi.limits.max_textures, Some(128));
+    assert_eq!(abi.limits.max_samplers, None);
+}
